ntent:space-between;gap:20px;margin-bottom:24px}.section-head h2{font-size:clamp(28px,4vw,42px);margin:8px 0}.section-head p{color:var(--muted);margin:0;line-height:1.6}.panel{background:linear-gradient(145deg,#0d1911,#09100c);border:1px solid #233a29;border-radius:18px;padding:22px}.map-layout{display:grid;grid-template-columns:1.3fr .7fr;gap:18px}.map-wrap{overflow:hidden;position:relative}.map-svg{width:100%;height:auto;display:block;max-height:550px}.sector{cursor:pointer;stroke:#07100b;stroke-width:3;transition:filter .15s,opacity .15s}.sector:hover,.sector.selected{filter:brightness(1.45);stroke:var(--neon);stroke-width:5}.map-label{font-size:13px;fill:#f1f8ed;font-weight:800;text-anchor:middle;pointer-events:none}.legend{display:flex;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12px;margin-top:15px}.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px}.info-title{font-size:22px;font-weight:900;margin:4px 0 10px}.price{color:var(--neon);font-size:30px;font-weight:900;margin:12px 0}.muted{color:var(--muted);font-size:13px;line-height:1.65}.seat-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:7px;margin:18px 0}.seat{aspect-ratio:1;border-radius:6px;border:1px solid #426b37;background:#182b1c;color:#c6f0ad;font-size:11px;padding:0}.seat:hover{border-color:var(--neon)}.seat.selected{background:var(--neon);color:#0b1408;border-color:var(--neon);font-weight:900}.seat.unavailable{background:#342022;color:#98686b;border-color:#4b2c30;cursor:not-allowed;text-decoration:line-through}.seat-legend{display:flex;gap:13px;flex-wrap:wrap;font-size:11px;color:var(--muted)}.seat-legend span:before{content:"";display:inline-block;width:9px;height:9px;border-radius:3px;background:#182b1c;border:1px solid #426b37;margin-right:5px}.seat-legend .busy:before{background:#342022;border-color:#4b2c30}.seat-legend .chosen:before{background:var(--neon);border-color:var(--neon)}.field-label{display:block;color:#b5c8b7;font-size