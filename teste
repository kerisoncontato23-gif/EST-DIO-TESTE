<div class="toast" id="toast" role="status"></div>
<script>
const views={home:document.getElementById('homeView'),map:document.getElementById('mapView'),seats:document.getElementById('seatsView'),tickets:document.getElementById('ticketsView'),tech:document.getElementById('techView')};
let currentView='home', selectedSector='Norte', selectedSeat=null;
const sectors={Norte:{price:80,desc:'Vista panorâmica atrás do gol. Ideal para acompanhar a energia da torcida.'},Leste:{price:120,desc:'Visão lateral do campo para acompanhar a movimentação do jogo.'},Sul:{price:75,desc:'Setor de torcida com preço demonstrativo mais acessível.'},Oeste:{price:160,desc:'Setor premium conceitual, com visão lateral central.'}};
const money=n=>n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
function toast(msg){let t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function showView(v){if(!views[v])return;currentView=v;Object.entries(views).forEach(([k,el])=>el.classList.toggle('hidden',k!==v));document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===v));window.scrollTo({top:0,behavior:'smooth'});if(v==='seats')renderSeats();if(v==='tickets')updateTicket()}
document.querySelectorAll('[data-view]').forEach(b=>b.addEventListener('click',()=>showView(b.dataset.view)));
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>{if(b.dataset.go==='seats'&&!selectedSector)selectedSector='Norte';showView(b.dataset.go)}));
function setSector(s){selectedSector=s;document.querySelectorAll('.sector').forEach(el=>el.classList.toggle('selected',el.dataset.sector===s));document.getElementById('sectorTitle').textContent=s;document.getElementById('sectorDescription').textContent=sectors[s].desc;document.getElementById('sectorPrice').textContent=money(sectors[s].price);const sel=document.getElementById('sectorSelect');if(sel)sel.value=s;if(currentView==='seats')renderSeats();updateTicket()}
document.querySelectorAll('.sector').forEach(el=>el.addEventListener('click',()=>{setSector(el.dataset.sector);toast('Setor '+el.dataset.sector+' selecionado')}));
document.getElementById('sectorSelect').addEventListener('change',e=>{setSector(e.target.value);selectedSeat=null;renderSeats()});
function renderSeats(){document.getElementById('seatSectorTitle').textContent=selectedSector;const grid=document.getElementById('seatGrid');grid.innerHTML='';for(let i=1;i<=40;i++){let btn=document.createElement('button');btn.className='seat';btn.textContent=String(i).padStart(2,'0');btn.setAttribute('aria-label','Assento '+i);const busy=[5,9,14,22,28,33,37].includes(i);if(busy){btn.classList.add('unavailable');btn.disabled=true;btn.title='Indisponível na demonstração'}else{if(selectedSeat===i)btn.classList.add('selected');btn.addEventListener('click',()=>{selectedSeat=i;renderSeats();updateSeatSummary()})}grid.appendChild(btn)}updateSeatSummary()}
function updateSeatSummary(){const name=selectedSeat?'Assento '+String(selectedSeat).padStart(2,'0'):'Nenhum assento';document.getElementById('seatSummary').textContent=name;document.getElementById('seatPrice').textContent=money(selectedSeat?sectors[selectedSector].price:0);document.getElementById('seatHint').textContent=selectedSeat?'Setor '+selectedSector+' · seleção demonstrativa.':'Selecione um lugar na grade para continuar.';document.getElementById('continueTicket').disabled=!selectedSeat}
document.getElementById('continueTicket').addEventListener('click',()=>showView('tickets'));
function updateTicket(){document.getElementById('ticketName').textContent=document.getElementById('buyer').value.trim()||'Convidado Nexus';document.getElementById('ticketDate').textContent=document.getElementById('eventDate').selectedOptions[0].text.replace('Domingo · ','').replace('Sábado · ','').replace('Quarta-feira · ','').toUpperCase();document.getElementById('ticketSector').textContent=selectedSector.toUpperCase();document.getElementById('ticketSeat').textContent=selectedSeat?String(selectedSeat).padStart(2,'0'):'Não selecionado';document.getElementById('ticketValue').textContent=money(selectedSeat?sectors[selectedSector].price:0)}
document.getElementById('generateTicket').addEventListener('click',()=>{updateTicket();toast('Ingresso demonstrativo atualizado')});
document.getElementById('buyer').addEventListener('input',updateTicket);document.getElementById('eventDate').addEventListener('change',updateTicket);
setSector('Norte');renderSeats();
</script>
